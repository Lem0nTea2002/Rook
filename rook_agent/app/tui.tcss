Screen {
    layout: vertical;
    background: $background;
    color: $foreground;
    overflow: hidden;
}

* {
    scrollbar-size-vertical: 0;
    scrollbar-size-horizontal: 0;
    scrollbar-color: transparent;
    scrollbar-background: transparent;
    scrollbar-color-hover: transparent;
    scrollbar-background-hover: transparent;
    scrollbar-color-active: transparent;
    scrollbar-background-active: transparent;
    scrollbar-corner-color: transparent;
}

ScrollBar,
ScrollBarCorner {
    display: none;
}

#main {
    height: 1fr;
    background: $background;
    overflow: hidden;
}

.topbar {
    height: auto;
    min-height: 1;
    max-height: 2;
    padding: 0 2;
    background: $surface;
    color: $rook-text-secondary;
    border-bottom: solid $rook-border;
    text-style: none;
}

#output {
    height: 1fr;
    padding: 1 3;
    background: $background;
}

#output.welcome-active {
    align: center middle;
}

.welcome {
    width: 100%;
    margin: 0;
    padding: 0;
    background: $background;
    color: $foreground;
}

.composer {
    height: auto;
    max-height: 9;
    margin: 0 2 1 2;
    padding: 0 1;
    background: $surface;
    border: solid $primary;
}

#input {
    height: 3;
    margin: 0;
    padding: 0 1;
    background: $surface;
    background-tint: transparent;
    color: $rook-text-secondary;
    border: none;
}

#input:focus {
    background: $surface;
    background-tint: transparent;
    color: $foreground;
    border: none;
}

#input > .input--cursor {
    background: $primary;
    color: $background;
    text-style: bold;
}

#input > .input--selection {
    background: $panel;
    color: $foreground;
}

#input > .text-area--placeholder {
    color: $rook-text-muted;
}

.activity-line {
    height: 1;
    margin: 0 3;
    color: $primary;
}

.todo-panel {
    height: auto;
    max-height: 8;
    margin: 0 3 1 3;
    padding: 0 1;
    color: $foreground;
    background: $panel;
    border-left: solid $secondary;
}

.todo-panel.hidden {
    display: none;
}

.footer-hints {
    height: 1;
    margin: 0 3;
    color: $rook-text-muted;
    background: $background;
}

ContentViewerScreen {
    layout: vertical;
    background: $background;
}

.viewer-title {
    height: 3;
    padding: 0 2;
    color: $foreground;
    background: $surface;
    border-bottom: solid $primary;
    content-align: left middle;
    text-style: bold;
}

#viewer-summary {
    height: auto;
    padding: 0 2 1 2;
    color: $primary;
    background: $surface;
}

#viewer-content {
    height: 1fr;
    border: none;
    background: $background;
    color: $foreground;
}

.command-palette {
    height: auto;
    max-height: 12;
    margin: 0 2;
    padding: 1 2;
    color: $foreground;
    background: $panel;
    border: solid $secondary;
}

.command-palette.hidden {
    display: none;
}

.composer.shell-mode {
    border: solid $warning;
    background: $surface;
}

.composer.shell-mode ComposerTextArea {
    color: $warning;
    background: $surface;
}

.composer.input-mode-command {
    border: solid $secondary;
}

.composer.input-mode-file_reference {
    border: solid $primary;
}

.composer.chat-running {
    border: solid $secondary;
}

.composer.queue-paused {
    border: solid $warning;
}

.message {
    width: 100%;
    margin: 0 0 1 0;
    padding: 0 1;
    background: $background;
}

.system-message,
.command-message,
.reasoning-message,
.tool-message {
    color: $rook-text-secondary;
    background: $background;
    border-left: solid $rook-border;
}

.tool-running,
.tool-done,
.tool-failed,
.tool-skipped,
.tool-denied {
    color: $rook-text-secondary;
    background: $background;
    border-left: solid $rook-border;
}

.tool-running {
    border-left: solid $secondary;
}

.tool-done {
    border-left: solid $primary;
}

.tool-failed,
.tool-denied {
    border-left: solid $error;
}

ToolCard,
PermissionCard {
    height: auto;
    padding: 0 1;
    margin: 0 0 1 0;
}

ToolCard:hover,
PermissionCard:hover {
    background: $panel;
}

.user-message {
    color: $foreground;
    background: $background;
    border-left: solid $secondary;
}

.assistant-message {
    color: $foreground;
    background: $background;
    border-left: solid $primary;
}

.assistant-message MarkdownBlock,
.command-message MarkdownBlock {
    margin: 0;
}

.queue-message {
    color: $rook-text-secondary;
    background: $background;
    border-left: solid $rook-border;
}

.queue-queued {
    border-left: solid $secondary;
}

.queue-running,
.queue-done {
    border-left: solid $primary;
}

.queue-paused {
    color: $warning;
    border-left: solid $warning;
}

.queue-cancelled {
    color: $rook-text-muted;
    border-left: solid $rook-border;
}

.reasoning-message {
    color: $rook-text-secondary;
    border-left: solid $primary;
}

.permission-message,
.permission-requested {
    color: $warning;
    background: $surface;
    border-left: solid $warning;
}

.error-message {
    color: $error;
    background: $surface;
    border-left: solid $error;
}

.streaming {
    border-left: solid $primary;
}

Screen.theme-high-contrast .composer,
Screen.theme-high-contrast .command-palette {
    border: double $primary;
}
