Screen {
    layout: vertical;
    background: #0b1117;
    color: #d8e4e8;
    overflow: hidden;
}

* {
    scrollbar-size-vertical: 0;
    scrollbar-size-horizontal: 0;
    scrollbar-color: transparent;
    scrollbar-background: transparent;
    scrollbar-color-hover: transparent;
    scrollbar-background-hover: transparent;
    scrollbar-color-active: transparent;
    scrollbar-background-active: transparent;
    scrollbar-corner-color: transparent;
}

ScrollBar,
ScrollBarCorner {
    display: none;
}

#main {
    height: 1fr;
    background: #0b1117;
    overflow: hidden;
}

.topbar {
    height: auto;
    min-height: 2;
    padding: 0 2;
    background: #101a22;
    color: #8a9aa4;
    border-bottom: solid #263d46;
    text-style: none;
}

#output {
    height: 1fr;
    padding: 1 3;
    background: #0b1117;
}

#output.welcome-active {
    align: center middle;
}

.welcome {
    width: 100%;
    margin: 0;
    padding: 0;
    background: #0b1117;
    color: #d8e4e8;
}

.composer {
    height: auto;
    max-height: 9;
    margin: 0 2 1 2;
    padding: 0 1;
    background: #101a22;
    border: round #2a6968;
}

#input {
    height: 3;
    margin: 0;
    padding: 0 1;
    background: #101a22;
    background-tint: transparent;
    color: #8a9aa4;
    border: none;
}

#input:focus {
    background: #101a22;
    background-tint: transparent;
    color: #f5fcfa;
    border: none;
}

#input > .input--cursor {
    background: #81e8bb;
    color: #07131b;
    text-style: none;
}

#input > .input--selection {
    background: #203b43;
    color: #f5fcfa;
}

#input > .text-area--placeholder {
    color: #74858f;
}

.activity-line {
    height: 1;
    margin: 0 3;
    color: #81e8bb;
}

.todo-panel {
    height: auto;
    max-height: 8;
    margin: 0 3 1 3;
    padding: 0 1;
    color: #d8e4e8;
    background: #101a22;
    border-left: solid #18cfcb;
}

.todo-panel.hidden {
    display: none;
}

.footer-hints {
    height: 1;
    margin: 0 3;
    color: #5f727c;
    background: #0b1117;
}

Screen.theme-high-contrast {
    background: #000000;
    color: #ffffff;
}

Screen.theme-high-contrast #topbar,
Screen.theme-high-contrast #composer,
Screen.theme-high-contrast #command-palette {
    background: #000000;
    color: #ffffff;
}

Screen.theme-high-contrast #topbar {
    border-bottom: solid #00ffff;
}

Screen.theme-high-contrast #composer,
Screen.theme-high-contrast #command-palette {
    border: round #00ffff;
}

ContentViewerScreen {
    layout: vertical;
    background: #0b1117;
}

.viewer-title {
    height: 3;
    padding: 1 2;
    color: #f5fcfa;
    background: #101a22;
    border-bottom: solid #2a6968;
    text-style: bold;
}

#viewer-summary {
    height: auto;
    padding: 0 2 1 2;
    color: #81e8bb;
    background: #101a22;
}

#viewer-content {
    height: 1fr;
    border: none;
    background: #0b1117;
    color: #d8e4e8;
}

.command-palette {
    height: auto;
    max-height: 12;
    margin: 0 2;
    padding: 1 2;
    color: #d8e4e8;
    background: #101a22;
    border: round #2a6968;
}

.command-palette.hidden {
    display: none;
}

.composer.shell-mode {
    border: round #f6b73c;
    background: #17150f;
}

.composer.shell-mode ComposerTextArea {
    color: #ffe3a6;
    background: #17150f;
}

.composer.input-mode-command {
    border: round #5fb5ff;
}

.composer.input-mode-file_reference {
    border: round #81e8bb;
}

.message {
    width: 100%;
    margin: 0 0 1 0;
    padding: 0 1 0 1;
    background: #0b1117;
}

.system-message,
.command-message,
.reasoning-message,
.tool-message {
    color: #808185;
    background: #0f1014;
    border-left: solid #666769;
}

.tool-running,
.tool-done,
.tool-failed,
.tool-skipped,
.tool-denied {
    color: #8a9aa4;
    background: #0b1117;
    border-left: solid #43535c;
}

ToolCard,
PermissionCard {
    height: auto;
    padding: 0 1;
    margin: 0 0 1 0;
}

ToolCard:hover,
PermissionCard:hover {
    background: #142029;
}

.user-message {
    color: #f5fcfa;
    background: #0e1820;
    border-left: solid #45e6df;
}

.assistant-message {
    color: #f5fcfa;
    background: #0e1817;
    border-left: solid #81e8bb;
}

.assistant-message MarkdownBlock {
    margin: 0;
}

.reasoning-message {
    color: #81bca7;
    border-left: solid #81e8bb;
}

.permission-message,
.permission-requested {
    color: #f6c453;
    background: #17150f;
    border-left: solid #f6c453;
}

.error-message {
    color: #ff8278;
    background: #1a1012;
    border-left: solid #ff8278;
}

.streaming {
    border-left: solid #81e8bb;
}
